{
  "name": "dsh-drag",
  "description": "Drag a conversation out of the dsh web sidebar's session list and drop it over the chat area to insert it into the composer draft as a session-reference chip (@[title](dsh-session:…)).",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "drag-and-drop",
    "sidebar",
    "session",
    "web"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttmouse/dsh-drag.git"
  },
  "homepage": "https://github.com/ttmouse/dsh-drag",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.2 <0.2.0-0 || >=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs && node test/apply-wiring.mjs && node test/session-resolution.mjs && node scripts/interaction.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "jsdom": "^26.0.0"
  }
}
